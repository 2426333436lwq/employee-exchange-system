# ============================================================
# points-exchange-system .gitignore
# 纯静态前端（HTML/CSS/JS），无构建步骤
# ============================================================

# ---------- 依赖与构建 ----------
node_modules/
dist/
build/
.cache/

# ---------- 环境与密钥 ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- 日志与临时文件 ----------
*.log
*.tmp
*.temp
*.bak
*.backup

# ---------- IDE / 工具残留 ----------
.reasonix/
reasonix.toml
.idea/
.vscode/
.trae/
.rivet/
*.swp
*~

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
