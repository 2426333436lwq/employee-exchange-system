# ============================================================
# employee-exchange-system .gitignore
# 员工积分兑换系统（前后端一体）
# ============================================================

# ---------- 依赖 ----------
node_modules/
.pnpm-store/
jspm_packages/
bower_components/
vendor/

# ---------- 构建产物 ----------
dist/
build/
output/
unpackage/
*.tsbuildinfo
.vite/
.cache/

# ---------- 后端运行时数据（可由 seed 重建，不入库） ----------
server/data/
**/server/data/
*.sqlite
*.sqlite3

# ---------- 数据库备份（含完整数据，严禁入库） ----------
backups/
**/backups/
*.sql.gz
*.sql
*_before_restore_*.sql

# ---------- 环境与密钥 ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- 日志与临时文件 ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.tmp
*.temp
*.bak
*.backup

# ---------- IDE / 工具残留 ----------
.reasonix/
reasonix.toml
.idea/
.vscode/
.trae/
.rivet/
*.swp
*.swo
*~

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
