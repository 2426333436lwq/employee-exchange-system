# =============================================================
#  环境变量模板
#  用法：cp .env.example .env  然后按实际环境填写
#  注意：.env 含密码，已在 .gitignore 中排除，切勿提交
# =============================================================

# development | production
NODE_ENV=development

# ---------- 服务 ----------
PORT=3000

# ---------- 数据库 ----------
# 生产实践：使用专用账号，不要用 root
# 账号创建见 server/sql/schema.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=exchange_app
DB_PASSWORD=请替换为实际密码
DB_NAME=employee_exchange
DB_POOL_SIZE=10

# ---------- 鉴权（生产必填） ----------
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为48字节以上随机字符串
# 令牌有效期（秒），默认 7 天
JWT_TTL=604800

# ---------- CORS 白名单（生产必填） ----------
# 逗号分隔的前端来源，必须显式列出，不允许 *
# 示例：https://admin.example.com,https://m.example.com
CORS_ORIGINS=http://localhost:8082,http://localhost:5173

# ---------- 限流 ----------
# 登录接口：窗口期（毫秒）内每 IP 最大尝试次数
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10
# 全局：每分钟每 IP 最大请求数
GLOBAL_RATE_MAX=300

# ---------- 日志 ----------
# trace | debug | info | warn | error
LOG_LEVEL=info
